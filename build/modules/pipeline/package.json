        "html-webpack-plugin": "^5.5.0",
        "inline-chunk-html-plugin": "^1.1.1",
        "nodemon": "1.11.0",
        "parallelshell": "3.0.1",
        "raw-loader": "^4.0.2",
        "stream-browserify": "^3.0.0",
        "style-loader": "^3.3.1",
        "terser-webpack-plugin": "^5.3.14",
        "url-loader": "^4.1.1",
